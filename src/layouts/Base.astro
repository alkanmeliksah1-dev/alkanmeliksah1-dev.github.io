---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/cormorant-garamond/300.css';
import '../styles/site.css';
import { LANGS, focal, nav, site, ui, type Lang } from '../data';
import { href } from '../lib';

interface Props {
  lang: Lang;
  slug?: string;        // '' = ana sayfa
  bg?: string;          // arka plan fotoğrafı
  home?: boolean;
}
const { lang, slug = '', bg, home = false } = Astro.props;
const current = nav.find((n) => n.slug === slug);
const pageTitle = home || !current ? `${site.name} — ${ui.role[lang]}` : `${current.label[lang]} — ${site.name}`;
const description = `${site.name} — ${ui.roles[lang]}, ${ui.city[lang]}.`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`https://meliksahalkan.com${href(l, slug)}`} />)}
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://meliksahalkan.com/images/night.jpg" />
</head>
<body class={home ? 'is-home' : ''}>
  {bg && (
    <div class={home ? 'backdrop backdrop--home' : 'backdrop'} aria-hidden="true">
      {home && <div class="backdrop-fill" style={`background-image:url(/images/${bg}.jpg)`}></div>}
      <picture>
        <source srcset={`/images/${bg}.webp`} type="image/webp" />
        <img src={`/images/${bg}.jpg`} alt="" style={focal[bg] ? `object-position:${focal[bg]}` : undefined} />
      </picture>
    </div>
  )}

  <header class="nav-panel">
    <button class="menu-btn" aria-expanded="false" aria-controls="menu">
      <span class="when-closed">{ui.menu[lang]}</span><span class="when-open">{ui.close[lang]}</span>
    </button>
    <div class="panel menu" id="menu">
      <nav>
        <ul>
          {nav.map((n) => (
            <li><a href={href(lang, n.slug)} aria-current={n.slug === slug ? 'page' : undefined}>{n.label[lang]}</a></li>
          ))}
        </ul>
      </nav>
      <div class="langs">
        {LANGS.map((l) => <a href={href(l, slug)} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
    const panel = document.querySelector('.nav-panel')!;
    const set = (open: boolean) => {
      panel.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', (e) => { e.stopPropagation(); set(!panel.classList.contains('open')); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    // menü dışına dokununca kapat
    document.addEventListener('click', (e) => { if (panel.classList.contains('open') && !(e.target as Element).closest('.menu')) set(false); });
    window.addEventListener('pageshow', () => set(false));
  </script>
</body>
</html>
