---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/cormorant-garamond/300.css';
import '../styles/site.css';
import { LANGS, nav, site, ui, type Lang } from '../data';
import Pic from '../components/Pic.astro';
import images from '../images.json';
import { href } from '../lib';

interface Props {
  lang: Lang;
  slug?: string;        // '' = ana sayfa
  bg?: string;          // arka plan fotoğrafı
  home?: boolean;
  section?: string;     // menüde vurgulanacak bölüm (alt sayfalar için)
  title?: string;       // sayfa başlığı (alt sayfalar için)
}
const { lang, slug = '', bg, home = false, section, title } = Astro.props;
const active = section ?? slug;
const bgMeta = bg ? (images as Record<string, { widths: number[] }>)[bg] : undefined;
const current = nav.find((n) => n.slug === active);
const pageTitle = title ? `${title} — ${site.name}` : home || !current ? `${site.name} — ${ui.role[lang]}` : `${current.label[lang]} — ${site.name}`;
const description = `${site.name} — ${ui.roles[lang]}, ${ui.city[lang]}.`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {bg && bgMeta && <link rel="preload" as="image" type="image/webp" imagesrcset={bgMeta.widths.map((w) => `/images/${bg}-${w}.webp ${w}w`).join(', ')} imagesizes="100vw" fetchpriority="high" />}
  <meta name="theme-color" content="#0b0a09" />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`https://meliksahalkan.com${href(l, slug)}`} />)}
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://meliksahalkan.com/images/night-ext.jpg" />
</head>
<body class={home ? 'is-home' : ''}>
  {bg && (
    <div class={home ? 'backdrop backdrop--home' : 'backdrop'} aria-hidden="true">
      <Pic name={bg} sizes="100vw" priority />
    </div>
  )}

  <header class="nav-panel">
    <div class="scrim" aria-hidden="true"></div>
    <button class="menu-btn" aria-expanded="false" aria-controls="menu">
      <span class="when-closed">{ui.menu[lang]}</span><span class="when-open">{ui.close[lang]}</span>
    </button>
    <div class="panel menu" id="menu">
      <nav>
        <ul>
          {nav.map((n) => (
            <li><a href={href(lang, n.slug)} aria-current={n.slug === active ? 'page' : undefined}>{n.label[lang]}</a></li>
          ))}
        </ul>
      </nav>
      <div class="langs">
        {LANGS.map((l) => <a href={href(l, slug)} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
    const panel = document.querySelector('.nav-panel')!;
    const set = (open: boolean) => {
      panel.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(!panel.classList.contains('open')));
    // menü dışında herhangi bir yere dokununca kapat (iOS dahil)
    panel.querySelector('.scrim')!.addEventListener('click', () => set(false));
    document.addEventListener('pointerdown', (e) => {
      if (panel.classList.contains('open') && !(e.target as Element).closest('.menu, .menu-btn')) set(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    window.addEventListener('pageshow', () => set(false));
    matchMedia('(min-width: 901px)').addEventListener('change', () => set(false));
  </script>
</body>
</html>
