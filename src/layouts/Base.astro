---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/cormorant-garamond/300.css';
import '../styles/site.css';
import { LANGS, anchors, focal, nav, photos, site, ui, type Lang } from '../data';
import Pic from '../components/Pic.astro';
import Flag from '../components/Flag.astro';
import { ClientRouter } from 'astro:transitions';
import images from '../images.json';
import { href } from '../lib';

interface Props {
  lang: Lang;
  slug?: string;        // '' = ana sayfa
  bg?: string;          // arka plan fotoğrafı
  home?: boolean;
  section?: string;     // menüde vurgulanacak bölüm (alt sayfalar için)
  title?: string;       // sayfa başlığı (alt sayfalar için)
}
const { lang, slug = '', bg, home = false, section, title } = Astro.props;
const active = section ?? slug;
const bgMeta = bg ? (images as Record<string, { w: number; h: number; widths: number[] }>)[bg] : undefined;
const anchor = bg ? anchors[bg] : undefined;
const ratio = bgMeta ? bgMeta.w / bgMeta.h : 1;
const bgSizes = anchor?.fit === 'height' ? `${Math.round(ratio * 100)}vh` : anchor ? `max(100vw, ${Math.round(ratio * 100)}vh)` : '100vw';
const current = nav.find((n) => n.slug === active);
// menüdeki her sayfanın arka planı: üzerine gelinince önceden indirilir
const IMG = images as Record<string, { w: number; h: number; widths: number[] }>;
const bgOf = (navSlug: string) => {
  const name = (photos as Record<string, string>)[navSlug || 'home']; const m = name && IMG[name];
  if (!m) return {};
  const a = anchors[name], r = m.w / m.h;
  const sizes = a?.fit === 'height' ? `${Math.round(r * 100)}vh` : a ? `max(100vw, ${Math.round(r * 100)}vh)` : '100vw';
  return { 'data-bg': name, 'data-bg-sizes': sizes, 'data-bg-srcset': m.widths.map((w) => `/images/${name}-${w}.webp ${w}w`).join(', ') };
};
const pageTitle = title ? `${title} — ${site.name}` : home || !current ? `${site.name} — ${ui.role[lang]}` : `${current.label[lang]} — ${site.name}`;
const description = `${site.name} — ${ui.roles[lang]}, ${ui.city[lang]}.`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <ClientRouter fallback="swap" />
  <script is:inline>try { if (!sessionStorage.getItem("brand-seen")) { document.documentElement.classList.add("brand-intro"); sessionStorage.setItem("brand-seen", "1"); } } catch (e) {}</script>
  <script is:inline>
    // İlk girişte dil: Türkiye'den ya da Türkçe tarayıcıdan → TR, Fransa / Fransızca → FR, diğerleri EN.
    // Yalnızca varsayılan (İngilizce) adreslere dışarıdan gelindiğinde çalışır; bayrakla yapılan seçim hatırlanır.
    (function () {
      if (window.__langChecked) return; window.__langChecked = true;
      try {
        var p = location.pathname, cur = /^\/(tr|fr)(\/|$)/.test(p) ? p.slice(1, 3) : 'en';
        if (cur !== 'en') return;
        if (document.referrer && new URL(document.referrer).host === location.host) return;
        var want = localStorage.getItem('lang-choice');
        if (!want) {
          var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']).map(function (l) { return String(l).toLowerCase(); });
          var tz = ''; try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
          var first = langs[0] || '';
          if (tz === 'Europe/Istanbul' || tz === 'Asia/Istanbul' || first.indexOf('tr') === 0) want = 'tr';
          else if (first.indexOf('fr') === 0 || tz === 'Europe/Paris' || tz === 'Europe/Monaco') want = 'fr';
          else want = 'en';
        }
        if (want === 'tr' || want === 'fr') location.replace('/' + want + p + location.search + location.hash);
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico?v=4" sizes="48x48" />
  <link rel="icon" href="/favicon-32.png?v=4" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=4" type="image/png" sizes="16x16" />
  <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" sizes="180x180" />
  <link rel="mask-icon" href="/mask-icon.svg?v=4" color="#0b0a09" />
  <link rel="manifest" href="/site.webmanifest" />
  {bg && bgMeta && <link rel="preload" as="image" type="image/webp" imagesrcset={bgMeta.widths.map((w) => `/images/${bg}-${w}.webp ${w}w`).join(', ')} imagesizes={bgSizes} fetchpriority="high" />}
  <meta name="theme-color" content="#0b0a09" />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`https://meliksahalkan.com${href(l, slug)}`} />)}
  <link rel="alternate" hreflang="x-default" href={`https://meliksahalkan.com${href('en', slug)}`} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:url" content={`https://meliksahalkan.com${href(lang, slug)}`} />
  <meta property="og:locale" content={{ en: 'en_GB', tr: 'tr_TR', fr: 'fr_FR' }[lang]} />
  <meta property="og:image" content="https://meliksahalkan.com/og.jpg" />
  <meta property="og:image:secure_url" content="https://meliksahalkan.com/og.jpg" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={site.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={`https://meliksahalkan.com${href(lang, slug)}`} />
</head>
<body class:list={[{ 'is-home': home }, slug && !slug.includes('/') ? `page-${slug}` : null]}>
  {bg && (
    <div class:list={['backdrop', { 'backdrop--home': home, 'backdrop--anchored': anchor }]} aria-hidden="true" transition:name="backdrop"
      data-fx={anchor?.fx} data-at={anchor?.at} data-fit={anchor?.fit} data-ratio={anchor ? ratio.toFixed(4) : undefined}
      style={anchor ? `--fx:${anchor.fx * 100}%` : undefined}>
      <Pic name={bg} sizes={bgSizes} priority />
    </div>
  )}

  {!home && (
    <a class="brand" href={href(lang, '')} aria-label={site.name}>
      {[...site.name].map((c, i) => <span style={`--i:${i}`}>{c === ' ' ? '\u00a0' : c}</span>)}
    </a>
  )}

  <header class="nav-panel">
    <div class="scrim" aria-hidden="true"></div>
    <button class="menu-btn" aria-expanded="false" aria-controls="menu">
      <span class="when-closed">{ui.menu[lang]}</span><span class="when-open">{ui.close[lang]}</span>
    </button>
    <div class="panel menu" id="menu">
      <nav>
        <ul>
          {nav.map((n) => (
            <li><a href={href(lang, n.slug)} aria-current={n.slug === active ? 'page' : undefined} {...bgOf(n.slug)}>{n.label[lang]}</a></li>
          ))}
        </ul>
      </nav>
      <div class="langs">
        {(['tr', 'en', 'fr'] as const).map((l) => <a href={href(l, slug)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} aria-label={{ tr: 'Türkçe', en: 'English', fr: 'Français' }[l]} title={{ tr: 'Türkçe', en: 'English', fr: 'Français' }[l]}><Flag code={l} /></a>)}
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class:list={['foot', { 'foot--home': home }]}>
    <p>© {new Date().getFullYear()} {site.name}. {ui.rights[lang]}</p>
  </footer>

  <script>
    // Sayfa geçişleri istemci tarafında yapılır (ClientRouter): başlık ve menü yeniden yüklenmez.
    // Bu yüzden kurulum her sayfa değişiminde yeniden çalışır; belge düzeyindeki dinleyiciler bir kez eklenir.
    let place: (() => void) | null = null;
    const panel = () => document.querySelector('.nav-panel');
    const setMenu = (open: boolean) => {
      const p = panel(), btn = document.querySelector('.menu-btn');
      if (!p || !btn) return;
      p.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
    };

    // Geniş ekranda arka plan fotoğrafını yüz hedef konuma gelecek şekilde yerleştir
    const setupBackdrop = () => {
      place = null;
      const bd = document.querySelector<HTMLElement>('.backdrop--anchored');
      if (!bd) return;
      const img = bd.querySelector('img')!; img.dataset.base ??= img.getAttribute('style') ?? ''; const base = img.dataset.base;
      const fx = parseFloat(bd.dataset.fx!), ratio = parseFloat(bd.dataset.ratio!), at = bd.dataset.at!, fit = bd.dataset.fit;
      place = () => {
        const vw = innerWidth, vh = innerHeight;
        if (vw <= 900 && vh > vw) { img.setAttribute('style', base); bd.classList.remove('backdrop--fit'); return; }
        const byHeight = fit === 'height' && vh * ratio < vw;
        bd.classList.toggle('backdrop--fit', byHeight);
        const w = byHeight ? vh * ratio : Math.max(vh * ratio, vw), h = w / ratio;
        let ax = parseFloat(at) * vw;
        if (at === 'between') {
          const m = document.querySelector('.nav-panel')!.getBoundingClientRect();
          const n = document.querySelector('.hero-name h1');
          const right = n ? n.getBoundingClientRect().left : vw;
          ax = (Math.max(m.right, 0) + right) / 2;
        }
        const left = byHeight ? Math.min(vw - w * 0.5, ax - fx * w) : Math.min(0, Math.max(vw - w, ax - fx * w));
        img.setAttribute('style', `${base};position:absolute;top:0;left:${left}px;width:${w}px;height:${h}px;max-width:none;object-fit:fill;transform-origin:${ax - left}px 40%`);
      };
      place(); bd.classList.add('is-placed');
    };

    // Görüntü alanına yaklaşan görselleri erkenden yükle (Safari'nin geç tembel yüklemesine karşı)
    let io: IntersectionObserver | null = null;
    const warmImages = () => {
      io?.disconnect();
      io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { (e.target as HTMLImageElement).loading = 'eager'; io!.unobserve(e.target); }
      }), { rootMargin: '1400px 0px' });
      document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((i) => io!.observe(i));
    };

    // Menüdeki sayfanın arka plan fotoğrafını, üzerine gelinince önceden indir
    const warmed = new Set<string>();
    const warmLinks = () => {
      document.querySelectorAll<HTMLAnchorElement>('a[data-bg]').forEach((a) => {
        const go = () => {
          const k = a.dataset.bg!; if (warmed.has(k)) return; warmed.add(k);
          const im = new Image(); im.sizes = a.dataset.bgSizes!; im.srcset = a.dataset.bgSrcset!;
        };
        a.addEventListener('pointerenter', go, { once: true });
        a.addEventListener('touchstart', go, { once: true, passive: true });
        a.addEventListener('focus', go, { once: true });
      });
    };

    const setup = () => {
      document.querySelector('.menu-btn')?.addEventListener('click', () => setMenu(!panel()!.classList.contains('open')));
      panel()?.querySelector('.scrim')?.addEventListener('click', () => setMenu(false));
      document.querySelectorAll('.langs a').forEach((a) => a.addEventListener('click', () => { try { localStorage.setItem('lang-choice', a.getAttribute('hreflang')!); } catch {} }));
      setupBackdrop();
      warmImages();
      warmLinks();
    };

    // bir kez: belge düzeyindeki dinleyiciler
    document.addEventListener('pointerdown', (e) => {
      const p = panel();
      if (p?.classList.contains('open') && !(e.target as Element).closest('.menu, .menu-btn')) setMenu(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
    addEventListener('resize', () => place?.(), { passive: true });
    document.fonts?.ready.then(() => place?.());
    matchMedia('(min-width: 901px)').addEventListener('change', () => setMenu(false));
    // yeni sayfa çizilmeden önce arka planı yerleştir (yanıp sönme olmasın)
    document.addEventListener('astro:after-swap', () => { setMenu(false); setupBackdrop(); });
    document.addEventListener('astro:page-load', setup);
  </script>
</body>
</html>
