---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/cormorant-garamond/300.css';
import '../styles/site.css';
import { LANGS, anchors, focal, nav, site, ui, type Lang } from '../data';
import Pic from '../components/Pic.astro';
import images from '../images.json';
import { href } from '../lib';

interface Props {
  lang: Lang;
  slug?: string;        // '' = ana sayfa
  bg?: string;          // arka plan fotoğrafı
  home?: boolean;
  section?: string;     // menüde vurgulanacak bölüm (alt sayfalar için)
  title?: string;       // sayfa başlığı (alt sayfalar için)
}
const { lang, slug = '', bg, home = false, section, title } = Astro.props;
const active = section ?? slug;
const bgMeta = bg ? (images as Record<string, { w: number; h: number; widths: number[] }>)[bg] : undefined;
const anchor = bg ? anchors[bg] : undefined;
const ratio = bgMeta ? bgMeta.w / bgMeta.h : 1;
const bgSizes = anchor?.fit === 'height' ? `${Math.round(ratio * 100)}vh` : anchor ? `max(100vw, ${Math.round(ratio * 100)}vh)` : '100vw';
const current = nav.find((n) => n.slug === active);
const pageTitle = title ? `${title} — ${site.name}` : home || !current ? `${site.name} — ${ui.role[lang]}` : `${current.label[lang]} — ${site.name}`;
const description = `${site.name} — ${ui.roles[lang]}, ${ui.city[lang]}.`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {bg && bgMeta && <link rel="preload" as="image" type="image/webp" imagesrcset={bgMeta.widths.map((w) => `/images/${bg}-${w}.webp ${w}w`).join(', ')} imagesizes={bgSizes} fetchpriority="high" />}
  <meta name="theme-color" content="#0b0a09" />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`https://meliksahalkan.com${href(l, slug)}`} />)}
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:url" content={`https://meliksahalkan.com${href(lang, slug)}`} />
  <meta property="og:locale" content={{ en: 'en_GB', tr: 'tr_TR', fr: 'fr_FR' }[lang]} />
  <meta property="og:image" content="https://meliksahalkan.com/og.jpg" />
  <meta property="og:image:secure_url" content="https://meliksahalkan.com/og.jpg" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={site.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={`https://meliksahalkan.com${href(lang, slug)}`} />
</head>
<body class:list={[{ 'is-home': home }, slug && !slug.includes('/') ? `page-${slug}` : null]}>
  {bg && (
    <div class:list={['backdrop', { 'backdrop--home': home, 'backdrop--anchored': anchor }]} aria-hidden="true"
      data-fx={anchor?.fx} data-at={anchor?.at} data-fit={anchor?.fit} data-ratio={anchor ? ratio.toFixed(4) : undefined}
      style={anchor ? `--fx:${anchor.fx * 100}%` : undefined}>
      <Pic name={bg} sizes={bgSizes} priority />
    </div>
  )}

  <header class="nav-panel">
    <div class="scrim" aria-hidden="true"></div>
    <button class="menu-btn" aria-expanded="false" aria-controls="menu">
      <span class="when-closed">{ui.menu[lang]}</span><span class="when-open">{ui.close[lang]}</span>
    </button>
    <div class="panel menu" id="menu">
      <nav>
        <ul>
          {nav.map((n) => (
            <li><a href={href(lang, n.slug)} aria-current={n.slug === active ? 'page' : undefined}>{n.label[lang]}</a></li>
          ))}
        </ul>
      </nav>
      <div class="langs">
        {LANGS.map((l) => <a href={href(l, slug)} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
    const panel = document.querySelector('.nav-panel')!;
    const set = (open: boolean) => {
      panel.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(!panel.classList.contains('open')));
    // menü dışında herhangi bir yere dokununca kapat (iOS dahil)
    panel.querySelector('.scrim')!.addEventListener('click', () => set(false));
    document.addEventListener('pointerdown', (e) => {
      if (panel.classList.contains('open') && !(e.target as Element).closest('.menu, .menu-btn')) set(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    window.addEventListener('pageshow', () => set(false));

    // Geniş ekranda arka plan fotoğrafını yüz hedef konuma gelecek şekilde yerleştir
    const bd = document.querySelector<HTMLElement>('.backdrop--anchored');
    if (bd) {
      const img = bd.querySelector('img')!; const base = img.getAttribute('style') ?? '';
      const fx = parseFloat(bd.dataset.fx!), ratio = parseFloat(bd.dataset.ratio!), at = bd.dataset.at!, fit = bd.dataset.fit;
      const place = () => {
        const vw = innerWidth, vh = innerHeight;
        if (vw <= 900 && vh > vw) { img.setAttribute('style', base); bd.classList.remove('backdrop--fit'); return; }
        const byHeight = fit === 'height' && vh * ratio < vw;
        bd.classList.toggle('backdrop--fit', byHeight);   // dikey telefon: normal kırpma
        const w = byHeight ? vh * ratio : Math.max(vh * ratio, vw), h = w / ratio;
        let ax = parseFloat(at) * vw;
        if (at === 'between') {
          const m = document.querySelector('.nav-panel')!.getBoundingClientRect();
          const n = document.querySelector('.hero-name h1');
          const right = n ? n.getBoundingClientRect().left : vw;
          ax = (Math.max(m.right, 0) + right) / 2;
        }
        const left = byHeight ? Math.min(vw - w * 0.5, ax - fx * w) : Math.min(0, Math.max(vw - w, ax - fx * w));
        img.setAttribute('style', `${base};position:absolute;top:0;left:${left}px;width:${w}px;height:${h}px;max-width:none;object-fit:fill;transform-origin:${ax - left}px 40%`);
      };
      place(); bd.classList.add('is-placed');
      addEventListener('resize', place, { passive: true });
      document.fonts?.ready.then(place);
    }
    matchMedia('(min-width: 901px)').addEventListener('change', () => set(false));
  </script>
</body>
</html>
