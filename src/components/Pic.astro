---
import { focal } from '../data';
const { name, alt = '', loading = 'lazy' } = Astro.props as { name: string; alt?: string; loading?: 'lazy' | 'eager' };
---
<picture>
  <source srcset={`/images/${name}.webp`} type="image/webp" />
  <img src={`/images/${name}.jpg`} alt={alt} loading={loading} decoding="async" style={focal[name] ? `object-position:${focal[name]}` : undefined} />
</picture>
