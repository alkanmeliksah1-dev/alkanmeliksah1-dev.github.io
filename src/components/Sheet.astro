---
import { nav, type Lang } from '../data';
const { lang, slug, title } = Astro.props as { lang: Lang; slug: string; title?: string };
const heading = title ?? nav.find((n) => n.slug === slug)!.label[lang];
---
<article class="panel sheet">
  <h1 class="sheet-title">{heading}</h1>
  <slot />
</article>
