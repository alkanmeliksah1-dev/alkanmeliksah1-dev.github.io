---
// Etiket–değer satırları: çalışmalar ve etkinliklerde ortak düzen.
const { rows } = Astro.props as { rows: { label: string; items: { text: string; href?: string }[] }[] };
---
<dl class="facts">
  {rows.map((r) => (
    <div class="fact">
      <dt>{r.label}</dt>
      <dd>{r.items.map((it) => (it.href ? <a href={it.href}>{it.text}</a> : <span>{it.text}</span>))}</dd>
    </div>
  ))}
</dl>
