---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import { events, nav, photos, ui, type Lang } from '../../data';
import { dateParts, langPaths } from '../../lib';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const title = nav.find((n) => n.slug === 'when')!.label[lang];
const today = new Date().toISOString().slice(0, 10);
const sorted = [...events].sort((a, b) => b.date.localeCompare(a.date));
const upcoming = sorted.filter((e) => e.date >= today).reverse();
const past = sorted.filter((e) => e.date < today);
const groups = [[ui.upcoming[lang], upcoming], [ui.past[lang], past]] as const;
---
<Base lang={lang} slug="when" title={title} bg={photos.when}>
  <Sheet title={title}>
    {groups.map(([label, list]) => (
      <>
        <h2>{label}</h2>
        {list.length === 0 ? <p class="muted">{ui.noUpcoming[lang]}</p> : (
          <ul class="events">
            {list.map((e) => {
              const d = dateParts(e.date, lang);
              return (
                <li class="event">
                  <div class="date"><span class="d">{d.day}</span><span class="m">{d.month} {d.year}</span></div>
                  <div class="event-body">
                    <h3>{e.title}</h3>
                    <p><em>{e.work}</em> · {e.performers}</p>
                    <p>{e.venue[lang]}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </>
    ))}
  </Sheet>
</Base>
