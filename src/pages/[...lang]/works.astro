---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import Pic from '../../components/Pic.astro';
import Lines from '../../components/Lines.astro';
import { categories, photos, works, type Lang } from '../../data';
import { href, langPaths } from '../../lib';
import { eventEyebrow, eventsOf, workSub } from '../../facts';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} slug="works" bg={photos.works}>
  <Sheet lang={lang} slug="works">
    <div class="cats">
      {categories.map((c) => (
        <a class="cat pop" href={`#${c.id}`}>
          <Pic name={c.image} sizes="(max-width: 900px) 92vw, 380px" />
          <span class="cat-label"><strong>{c.title[lang]}</strong><span class="label">{c.blurb[lang]}</span></span>
        </a>
      ))}
    </div>
    {categories.map((c) => (
      <section class="cat-section" id={c.id}>
        <h2>{c.title[lang]}</h2>
        <ul class="entries">
          {works.filter((w) => w.cat === c.id).sort((a, b) => b.year.localeCompare(a.year)).map((w) => (
            <li class="entry card">
              <div class="entry-body">
                <p class="eyebrow">{w.year}</p>
                <h3 class="entry-title"><a class="card-link" href={href(lang, `works/${w.slug}`)}>{w.title}</a></h3>
                {workSub(w, lang) && <p class="sub">{workSub(w, lang)}</p>}
                {eventsOf(w).map((e) => (
                  <div class="perf">
                    <a class="perf-name" href={href(lang, `events/${e.slug}`)}>{eventEyebrow(e, lang)}</a>
                    <Lines e={e} lang={lang} />
                  </div>
                ))}
                {w.award && <p class="award">{w.award[lang]}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </Sheet>
</Base>
