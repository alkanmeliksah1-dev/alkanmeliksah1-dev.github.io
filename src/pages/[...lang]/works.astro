---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import Pic from '../../components/Pic.astro';
import { categories, photos, ui, works, type Lang } from '../../data';
import { langPaths } from '../../lib';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} slug="works" bg={photos.works}>
  <Sheet lang={lang} slug="works">
    <div class="cats">
      {categories.map((c) => (
        <a class="cat" href={`#${c.id}`}>
          <Pic name={c.image} sizes="(max-width: 900px) 66vw, 380px" />
          <span class="cat-label"><strong>{c.title[lang]}</strong><span class="label">{c.blurb[lang]}</span></span>
        </a>
      ))}
    </div>
    {categories.map((c) => (
      <section class="cat-section" id={c.id}>
        <h2>{c.title[lang]}</h2>
        <ul class="rows">
          {works.filter((w) => w.cat === c.id).sort((a, b) => b.year.localeCompare(a.year)).map((w) => (
            <li>
              <span class="k">{w.year}</span>
              <div>
                <div class="work-title">{w.title}</div>
                <div class="work-meta">{w.scoring[lang]}{w.note && <><br />{w.note[lang]}</>}</div>
                {w.links && (
                  <div class="links">
                    {w.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.kind === 'watch' ? ui.watchOn[lang] : ui.listenOn[lang]}</a>)}
                  </div>
                )}
              </div>
              {w.poster ? <span class="thumb graded"><Pic name={w.poster} alt="" sizes="92px" /></span> : <span></span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </Sheet>
</Base>
