---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import Pic from '../../components/Pic.astro';
import { gallery, photos, ui, type Lang } from '../../data';
import { langPaths } from '../../lib';
import images from '../../images.json';
const meta = images as Record<string, { w: number; h: number }>;
// görselleri yüksekliğe göre sütunlara dağıt (masonry)
const split = <T extends { img: string }>(items: T[], n: number) => {
  const cols: T[][] = Array.from({ length: n }, () => []); const hs = new Array(n).fill(0);
  for (const it of items) { const i = hs.indexOf(Math.min(...hs)); cols[i].push(it); hs[i] += meta[it.img].h / meta[it.img].w; }
  return cols;
};
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} slug="gallery" bg={photos.gallery}>
  <Sheet lang={lang} slug="gallery">
    <div class="tabs gallery-tabs" role="tablist">
      {gallery.map((g, i) => (
        <button role="tab" id={`tab-${g.id}`} aria-controls={g.id} aria-selected={i === 0 ? 'true' : 'false'}>{g.title[lang]}</button>
      ))}
    </div>
    {gallery.map((g, i) => (
      <section class="gallery" id={g.id} role="tabpanel" aria-labelledby={`tab-${g.id}`} hidden={i !== 0}>
        {[3, 2].map((n) => (
          <div class={`gcols g${n}`}>
            {split(g.items, n).map((col) => (
              <div class="gcol">
                {col.map((it) => <figure class="graded pop"><Pic name={it.img} alt={it.alt} sizes={n === 3 ? '260px' : '46vw'} /></figure>)}
              </div>
            ))}
          </div>
        ))}
      </section>
    ))}
  </Sheet>
  <script>
    // Galeri. Betik, sayfa yenilenmeden gelindiğinde de (Safari dahil) her seferinde bir kez bağlanır.
    const init = () => {
      const root = document.querySelector<HTMLElement>('.gallery-tabs');
      if (!root || root.dataset.bound) return;
      root.dataset.bound = '1';
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('button')];
      const layoutOf = (sec: Element) => sec.querySelector(matchMedia('(max-width: 700px)').matches ? '.g2' : '.g3');

      // Fotoğraf önce tamamen inip çözülür, sonra yalnızca GPU ile (saydamlık + kaydırma) süzülür: takılma olmaz
      const appear = (f: HTMLElement, delay: number) => {
        const img = f.querySelector('img')!;
        const pic = f.querySelector('picture')!;
        img.loading = 'eager';
        const run = () => {
          pic.style.willChange = 'opacity, transform';
          f.style.setProperty('--d', `${delay}ms`);
          requestAnimationFrame(() => f.classList.add('in'));
          setTimeout(() => { pic.style.willChange = ''; }, delay + 1300);
        };
        (img.complete && img.naturalWidth ? img.decode() : new Promise((r) => { img.addEventListener('load', r, { once: true }); img.addEventListener('error', r, { once: true }); }).then(() => img.decode()))
          .catch(() => {}).then(run);
      };
      // ekrana yaklaşan fotoğrafları önceden indir, ekrana girince sırayla göster
      const pre = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { (e.target.querySelector('img') as HTMLImageElement).loading = 'eager'; pre.unobserve(e.target); } }), { rootMargin: '900px 0px' });
      const io = new IntersectionObserver((es) => {
        let n = 0;
        es.filter((e) => e.isIntersecting).forEach((e) => { io.unobserve(e.target); appear(e.target as HTMLElement, Math.min(n++, 6) * 80); });
      }, { rootMargin: '0px 0px 40px 0px' });
      const reveal = (id: string) => {
        const lay = layoutOf(document.getElementById(id)!);
        lay?.querySelectorAll<HTMLElement>('figure').forEach((f) => { pre.observe(f); io.observe(f); });
      };
      const show = (id: string) => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.getAttribute('aria-controls') === id)));
        document.querySelectorAll<HTMLElement>('section.gallery').forEach((s) => { s.hidden = s.id !== id; });
      };
      tabs.forEach((t) => {
        const id = t.getAttribute('aria-controls')!;
        // üzerine gelince o sekmenin görsellerini önceden indir
        t.addEventListener('pointerenter', () => layoutOf(document.getElementById(id)!)?.querySelectorAll('img').forEach((i) => (i.loading = 'eager')), { once: true });
        t.addEventListener('click', () => {
          document.querySelectorAll<HTMLElement>(`#${id} figure`).forEach((f) => { io.unobserve(f); f.classList.remove('in'); });
          show(id);
          requestAnimationFrame(() => requestAnimationFrame(() => reveal(id)));
        });
      });
      const start = location.hash && document.getElementById(location.hash.slice(1)) ? location.hash.slice(1) : tabs[0].getAttribute('aria-controls')!;
      show(start);
      // menüden gelindiyse sayfa geçişi tamamen bitene kadar bekle; iki animasyon üst üste binmez
      const settled: Promise<unknown> | null = (window as any).__settled;
      if (settled) settled.then(() => requestAnimationFrame(() => reveal(start))); else reveal(start);
    };
    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Base>
