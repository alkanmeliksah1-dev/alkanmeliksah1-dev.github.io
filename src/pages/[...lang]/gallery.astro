---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import Pic from '../../components/Pic.astro';
import { gallery, photos, ui, type Lang } from '../../data';
import { langPaths } from '../../lib';
import images from '../../images.json';
const meta = images as Record<string, { w: number; h: number }>;
// görselleri yüksekliğe göre sütunlara dağıt (masonry)
const split = <T extends { img: string }>(items: T[], n: number) => {
  const cols: T[][] = Array.from({ length: n }, () => []); const hs = new Array(n).fill(0);
  for (const it of items) { const i = hs.indexOf(Math.min(...hs)); cols[i].push(it); hs[i] += meta[it.img].h / meta[it.img].w; }
  return cols;
};
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} slug="gallery" bg={photos.gallery}>
  <Sheet lang={lang} slug="gallery">
    <div class="tabs gallery-tabs" role="tablist">
      {gallery.map((g, i) => (
        <button role="tab" id={`tab-${g.id}`} aria-controls={g.id} aria-selected={i === 0 ? 'true' : 'false'}>{g.title[lang]}</button>
      ))}
    </div>
    {gallery.map((g, i) => (
      <section class="gallery" id={g.id} role="tabpanel" aria-labelledby={`tab-${g.id}`} hidden={i !== 0}>
        {[3, 2].map((n) => (
          <div class={`gcols g${n}`}>
            {split(g.items, n).map((col) => (
              <div class="gcol">
                {col.map((it) => <figure class="graded pop"><Pic name={it.img} alt={it.alt} sizes={n === 3 ? '260px' : '46vw'} /></figure>)}
              </div>
            ))}
          </div>
        ))}
      </section>
    ))}
  </Sheet>
  <script>
    document.addEventListener('astro:page-load', () => {
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('.gallery-tabs button')];
      if (!tabs.length) return;
      // görünür hale gelen fotoğraflar, yüklendikçe sırayla alttan süzülerek belirir
      const io = new IntersectionObserver((es) => {
        let n = 0;
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          const f = e.target as HTMLElement; io.unobserve(f);
          const img = f.querySelector('img')!;
          f.style.setProperty('--d', `${Math.min(n++, 6) * 90}ms`);
          const go = () => requestAnimationFrame(() => f.classList.add('in'));
          img.complete ? go() : (img.addEventListener('load', go, { once: true }), img.addEventListener('error', go, { once: true }));
        });
      }, { rootMargin: '0px 0px 40px 0px' });
      const reveal = () => document.querySelectorAll<HTMLElement>('section.gallery:not([hidden]) figure:not(.in)').forEach((f) => io.observe(f));
      const show = (id: string) => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.getAttribute('aria-controls') === id)));
        document.querySelectorAll<HTMLElement>('section.gallery').forEach((s) => { s.hidden = s.id !== id; });
      };
      // sekme değişince o sekmenin fotoğrafları efektle yeniden gelir
      tabs.forEach((t) => t.addEventListener('click', () => {
        const id = t.getAttribute('aria-controls')!;
        document.querySelectorAll<HTMLElement>(`#${id} figure`).forEach((f) => { io.unobserve(f); f.classList.remove('in'); });
        show(id);
        requestAnimationFrame(() => requestAnimationFrame(reveal));
      }));
      if (location.hash && document.getElementById(location.hash.slice(1))) show(location.hash.slice(1));
      reveal();
    });
  </script>
</Base>
