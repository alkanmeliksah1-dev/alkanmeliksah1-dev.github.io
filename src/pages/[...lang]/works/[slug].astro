---
import Base from '../../../layouts/Base.astro';
import Sheet from '../../../components/Sheet.astro';
import Lines from '../../../components/Lines.astro';
import { photos, ui, works, type Lang } from '../../../data';
import { detailPaths, href } from '../../../lib';
import { eventEyebrow, eventsOf, workSub } from '../../../facts';
export const getStaticPaths = () => detailPaths(works);
const { lang, item: w } = Astro.props as { lang: Lang; item: (typeof works)[number] };
const notes = w.notes ? (w.notes[lang] ?? w.notes.en) : undefined;
const notesLang = w.notes && w.notes[lang] ? lang : 'en';
---
<Base lang={lang} slug={`works/${w.slug}`} section="works" title={w.title} bg={photos.works}>
  <Sheet lang={lang} slug="works" title={w.title} kicker={w.year}>
    {workSub(w, lang) && <p class="sub">{workSub(w, lang)}</p>}
    {eventsOf(w).map((e) => (
      <div class="perf">
        <a class="perf-name" href={href(lang, `events/${e.slug}`)}>{eventEyebrow(e, lang)}</a>
        <Lines e={e} lang={lang} />
      </div>
    ))}
    {w.award && <p class="award">{w.award[lang]}</p>}
    {w.links && <p class="links">{w.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.kind === 'watch' ? ui.watchOn[lang] : ui.listenOn[lang]}</a>)}</p>}
    {notes && (
      <>
        <h2>{ui.programNotes[lang]}</h2>
        <div class="prose" lang={notesLang}>{notes.map((p) => <p>{p}</p>)}</div>
      </>
    )}
    <p class="back"><a href={href(lang, 'works')}>{ui.allWorks[lang]}</a></p>
  </Sheet>
</Base>
