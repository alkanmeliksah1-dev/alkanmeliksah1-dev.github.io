---
import Base from '../../../layouts/Base.astro';
import Sheet from '../../../components/Sheet.astro';
import Pic from '../../../components/Pic.astro';
import Facts from '../../../components/Facts.astro';
import { events, photos, ui, type Lang } from '../../../data';
import { detailPaths, href } from '../../../lib';
import { eventFacts, kindLabel } from '../../../facts';
export const getStaticPaths = () => detailPaths(events);
const { lang, item: e } = Astro.props as { lang: Lang; item: (typeof events)[number] };
const listTitle = e.kind === 'release' ? ui.tracklist[lang] : ui.program[lang];
---
<Base lang={lang} slug={`events/${e.slug}`} section="events" title={e.title} bg={photos.events}>
  <Sheet lang={lang} slug="events" title={e.title}>
    <div class:list={['detail', { 'has-poster': e.poster }]}>
      <div>
        <p class="eyebrow">{kindLabel(e, lang)}</p>
        <Facts rows={eventFacts(e, lang)} />
        {e.lineup && (
          <>
            <h2>{ui.performers[lang]}</h2>
            <ul class="pairs">{e.lineup.map((p) => <li><span>{p.name}</span><span>{p.role[lang]}</span></li>)}</ul>
          </>
        )}
        {e.program && (
          <>
            <h2>{listTitle}</h2>
            <ol class="program">
              {e.program.map((p) => (
                <li class:list={{ me: p.me }}>
                  <span>{p.composer === '—' ? '' : p.composer}</span>
                  <span><em>{p.work}</em>{p.year && ` (${p.year})`}</span>
                </li>
              ))}
            </ol>
          </>
        )}
        {e.credits && (
          <>
            <h2>{ui.credits[lang]}</h2>
            <ul class="pairs">{e.credits.filter((c) => !['Text', 'Director', 'Director / choreographer'].includes(c.role.en)).map((c) => <li class:list={{ me: c.names.includes('Melikşah Alkan') }}><span>{c.role[lang]}</span><span>{c.names}</span></li>)}</ul>
          </>
        )}
        {e.source && <p class="note">{ui.source[lang]}: <a href={e.source} target="_blank" rel="noopener">{new URL(e.source).hostname.replace('www.', '')}</a></p>}
      </div>
      {e.poster && <div class="detail-poster"><div class="pop"><Pic name={e.poster} alt={`${ui.poster[lang]}: ${e.title}`} sizes="(max-width: 760px) 80vw, 300px" /></div></div>}
    </div>
    <p class="back"><a href={href(lang, 'events')}>{ui.allEvents[lang]}</a></p>
  </Sheet>
</Base>
