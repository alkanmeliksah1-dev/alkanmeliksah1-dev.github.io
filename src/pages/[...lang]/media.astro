---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import { photos, recordings, ui, type Lang } from '../../data';
import { langPaths } from '../../lib';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const sc = (url: string) => `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&color=%23c6a571&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false`;
---
<Base lang={lang} slug="media" bg={photos.media}>
  <Sheet lang={lang} slug="media">
    {recordings.map((r) => (
      <section class="rec">
        <div class="rec-head">
          <div><div class="work-title">{r.title}</div><div class="work-meta">{r.meta[lang]}</div></div>
          <a class="text-link" href={r.url} target="_blank" rel="noopener">{r.type === 'youtube' ? 'YouTube' : 'SoundCloud'} ↗</a>
        </div>
        {r.type === 'youtube'
          ? <div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${r.id}`} title={r.title} loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe></div>
          : <iframe class="sc" src={sc(r.url)} title={r.title} loading="lazy" allow="autoplay"></iframe>}
      </section>
    ))}
  </Sheet>
</Base>
