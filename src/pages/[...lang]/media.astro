---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import Lines from '../../components/Lines.astro';
import { events, mediaSections, photos, recordings, ui, works, type Lang } from '../../data';
import { href, langPaths } from '../../lib';
import { eventEyebrow, workSub } from '../../facts';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
// SoundCloud oynatıcısı açık renkli; sayfada tersine çevrilerek koyu gösterilir.
// Renk parametresi, tersine çevrildikten sonra sitenin pirinç rengine (#c6a571) denk gelecek şekilde seçildi.
const sc = (url: string) => `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&color=%238e5a39&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&show_artwork=false&visual=false`;
---
<Base lang={lang} slug="media" bg={photos.media}>
  <Sheet lang={lang} slug="media">
    {mediaSections.map((s, si) => {
      const list = recordings.filter((r) => r.section === s.id);
      return list.length > 0 && (
        <section>
          <h2 style={si === 0 ? 'margin-top:0' : undefined}>{s.title[lang]}</h2>
          <ul class="entries">
            {list.map((r) => {
              const e = events.find((x) => x.slug === r.event)!;
              const title = typeof r.title === 'string' ? r.title : r.title[lang];
              const w = works.find((x) => x.title === title);
              return (
                <li class="entry">
                  <div class="entry-body">
                    <p class="eyebrow"><a href={href(lang, `events/${e.slug}`)}>{eventEyebrow(e, lang)}</a></p>
                    <h3 class="entry-title">{w ? <a href={href(lang, `works/${w.slug}`)}>{title}</a> : title}</h3>
                    {workSub(w, lang) && <p class="sub">{workSub(w, lang)}</p>}
                    <Lines e={e} lang={lang} talk={r.section === 'talks'} />
                    <div class="player">
                      {r.type === 'youtube'
                        ? (
                          <button type="button" class="facade video" data-embed={`https://www.youtube-nocookie.com/embed/${r.id}?autoplay=1&rel=0`} data-title={title} aria-label={`${ui.watchOn[lang]}: ${title}`}>
                            <img src={`https://i.ytimg.com/vi/${r.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
                            <span class="play" aria-hidden="true"></span>
                          </button>
                        )
                        : (
                          <button type="button" class="facade sc-facade" data-embed={sc(r.url).replace('auto_play=false', 'auto_play=true')} data-title={title} data-sc aria-label={`${ui.listenOn[lang]}: ${title}`}>
                            <span class="play" aria-hidden="true"></span>
                            <span class="sc-meta"><span class="sc-who">Melikşah Alkan</span><span class="sc-title">{title}</span></span>
                            <span class="sc-brand" aria-hidden="true">SoundCloud</span>
                          </button>
                        )}
                    </div>
                    <p class="links">
                      <a href={r.url} target="_blank" rel="noopener">{r.type === 'youtube' ? ui.watchOn[lang] : ui.listenOn[lang]}</a>
                      {r.listen && <a href={r.listen} target="_blank" rel="noopener">{ui.listenOn[lang]}</a>}
                    </p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </Sheet>
  <script>
    // Video ve ses oynatıcıları yalnızca tıklanınca yüklenir: sayfa anında açılır.
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLButtonElement>('.facade').forEach((b) => b.addEventListener('click', () => {
        const f = document.createElement('iframe');
        f.src = b.dataset.embed!; f.title = b.dataset.title!;
        f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'; f.allowFullscreen = true;
        f.className = b.hasAttribute('data-sc') ? 'sc' : '';
        if (b.hasAttribute('data-sc')) b.replaceWith(f);
        else { const wrap = document.createElement('div'); wrap.className = 'video'; wrap.append(f); b.replaceWith(wrap); }
      }, { once: true }));
    });
  </script>
</Base>
