---
import Base from '../../layouts/Base.astro';
import { portraitAlt } from '../../seo';
import Sheet from '../../components/Sheet.astro';
import Pic from '../../components/Pic.astro';
import { bio, photos, site, type Lang } from '../../data';
import { langPaths } from '../../lib';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} slug="about" bg={photos.about}>
  <Sheet lang={lang} slug="about">
    <div class="about-grid">
      <figure class="graded"><Pic name={photos.portrait} alt={portraitAlt(lang)} loading="eager" sizes="280px" /></figure>
      <div class="prose">{bio[lang].map((p) => <p>{p}</p>)}</div>
    </div>
  </Sheet>
</Base>
