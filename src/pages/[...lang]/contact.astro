---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import { photos, site, ui, type Lang } from '../../data';
import { langPaths } from '../../lib';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const names: Record<string, string> = { youtube: 'YouTube', soundcloud: 'SoundCloud', instagram: 'Instagram', facebook: 'Facebook', x: 'X (Twitter)' };
const icons: Record<string, string> = {
  youtube: 'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6z',
  soundcloud: 'M24 14.2c0 1.8-1.6 3.1-3.4 3.1h-8.2a.7.7 0 0 1-.7-.7V7.9c0-.3.2-.6.5-.7 0 0 .7-.5 2.3-.5a5.4 5.4 0 0 1 5.3 4.3 3.2 3.2 0 0 1 4.2 3.2zM10.7 8.4c.3 3 .4 5.7 0 8.7a.3.3 0 0 1-.5 0c-.4-3-.2-5.7 0-8.7a.3.3 0 0 1 .5 0zM9.1 9.4c.3 2.7.4 5 0 7.7a.3.3 0 0 1-.6 0c-.3-2.6-.3-5 0-7.7a.3.3 0 0 1 .6 0zM7.4 9.2c.3 2.7.4 5.2 0 7.9a.3.3 0 0 1-.5 0c-.4-2.7-.3-5.2 0-7.9a.3.3 0 0 1 .5 0zM5.8 10c.3 2.4.3 4.7 0 7.1a.3.3 0 0 1-.6 0c-.3-2.4-.3-4.7 0-7.1a.3.3 0 0 1 .6 0zM4.1 11.7c.4 1.9.2 3.5 0 5.4a.3.3 0 0 1-.5 0c-.2-1.9-.4-3.5 0-5.4a.3.3 0 0 1 .5 0z',
  instagram: 'M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zm0 3.6a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zm0 10.2a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z',
  x: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z',
  facebook: 'M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z',
};
const socials = Object.entries(site.social).filter(([, url]) => url);
const t = (k: keyof typeof ui) => (ui[k] as Record<Lang, string>)[lang];
const nlAction = site.forms.newsletter[lang];
---
<Base lang={lang} slug="contact" bg={photos.contact}>
  <Sheet lang={lang} slug="contact">
    <a class="contact-line" href={`mailto:${site.email}`}>{site.email}</a>
    {socials.length > 0 && (
      <ul class="socials">
        {socials.map(([k, u]) => (
          <li><a href={u} target="_blank" rel="noopener" aria-label={names[k]} title={names[k]}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[k]} /></svg></a></li>
        ))}
      </ul>
    )}

    <div class="tabs ctabs" role="tablist" aria-label={t('tabMessage') + ' / ' + t('tabNewsletter')}>
      <button type="button" role="tab" id="tab-message" aria-controls="p-message" aria-selected="true">{t('tabMessage')}</button>
      <button type="button" role="tab" id="tab-newsletter" aria-controls="p-newsletter" aria-selected="false" tabindex="-1">{t('tabNewsletter')}</button>
    </div>

    <section class="cpanel" id="p-message" role="tabpanel" aria-labelledby="tab-message">
      <form class="cform" data-kind="message" action={site.forms.contact} method="post" novalidate>
        <div class="field"><label for="c-name">{t('fName')}</label><input id="c-name" name="name" type="text" autocomplete="name" required maxlength="120" /></div>
        <div class="field"><label for="c-email">{t('fEmail')}</label><input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" spellcheck="false" autocapitalize="off" /></div>
        <div class="field">
          <label for="c-subject">{t('fSubject')}</label>
          <select id="c-subject" name="subject" required>
            <option value="" disabled selected>{t('fSubjectPick')}</option>
            {ui.subjects[lang].map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
        <div class="field"><label for="c-message">{t('fMessage')}</label><textarea id="c-message" name="message" rows="6" required maxlength="5000"></textarea></div>
        <input class="hp" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="submit" type="submit">{t('fSend')}</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="cpanel" id="p-newsletter" role="tabpanel" aria-labelledby="tab-newsletter">
      <p class="nl-lead">{t('nlLead')}</p>
      <form class="cform" data-kind="newsletter" data-brevo={nlAction ? 'true' : undefined} action={nlAction || site.forms.contact} method="post" novalidate>
        <div class="field"><label for="n-name">{t('fNameOpt')}</label><input id="n-name" name="FIRSTNAME" type="text" autocomplete="given-name" maxlength="80" /></div>
        <div class="field"><label for="n-email">{t('fEmail')}</label><input id="n-email" name="EMAIL" type="email" autocomplete="email" inputmode="email" required maxlength="200" spellcheck="false" autocapitalize="off" /></div>
        <input class="hp" type="text" name="email_address_check" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="locale" value={lang} />
        <input type="hidden" name="html_type" value="simple" />
        <button class="submit" type="submit">{t('fSubscribe')}</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </section>
  </Sheet>

<div id="contact-l" hidden data-l={JSON.stringify({
  sending: t('fSending'), ok: t('msgOk'), err: t('msgErr'), nlConfirm: t('nlConfirm'), nlOk: t('nlOk'), nlDone: t('nlDone'),
  email: site.email, contact: site.forms.contact, lang,
})}></div>
<script>
  // Sayfa her açıldığında (yenilemeden gelinse de, betik geç yüklense de) bir kez bağlanır
  const init = () => {
  const holder = document.getElementById('contact-l'); if (!holder || holder.dataset.bound) return;
  holder.dataset.bound = '1';
  const L = JSON.parse(holder.dataset.l);

  // ---- sekmeler ----
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.ctabs [role=tab]')];
  const show = (id, focus) => {
    tabs.forEach((b) => {
      const on = b.getAttribute('aria-controls') === id;
      b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1;
      document.getElementById(b.getAttribute('aria-controls')).hidden = !on;
      if (on && focus) b.focus();
    });
  };
  document.documentElement.classList.add('tabs-ready');
  const fromHash = () => (location.hash === '#newsletter' ? 'p-newsletter' : 'p-message');
  show(fromHash());
  // Brevo'daki onay bağlantısından dönüş: bülten sekmesinde teşekkür mesajı
  const done = new URLSearchParams(location.search).get('subscribed') === '1';
  if (done) {
    show('p-newsletter');
    history.replaceState(history.state, '', location.pathname + '#newsletter');
  }
  tabs.forEach((b, i) => {
    b.addEventListener('click', () => { show(b.getAttribute('aria-controls')); history.replaceState(history.state, '', '#' + b.getAttribute('aria-controls').slice(2)); });
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      show(n.getAttribute('aria-controls'), true);
    });
  });

  // ---- formlar ----
  const post = (url, data) => fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) })
    .then((r) => r.json()).then((j) => { if (String(j.success) !== 'true') throw new Error(j.message || 'failed'); });

  document.querySelectorAll('.cform').forEach((form) => {
    const status = form.querySelector('.status'), btn = form.querySelector('.submit'), label = btn.textContent;
    const say = (msg, kind, link) => {
      status.className = 'status' + (kind ? ' is-' + kind : ''); status.textContent = msg;
      if (link) { const a = document.createElement('a'); a.href = 'mailto:' + L.email; a.textContent = L.email; status.append(' ', a); }
    };
    if (done && form.dataset.kind === 'newsletter') say(L.nlDone, 'ok');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.classList.add('was-checked');
        form.querySelector(':invalid')?.focus();
        return;
      }
      const fd = new FormData(form);
      if (fd.get('_honey') || fd.get('email_address_check')) return;   // bot
      btn.disabled = true; btn.textContent = L.sending; say('');
      try {
        if (form.dataset.kind === 'message') {
          await post(L.contact, {
            name: fd.get('name'), email: fd.get('email'), subject: fd.get('subject'), message: fd.get('message'),
            _subject: 'meliksahalkan.com · ' + fd.get('subject') + ' · ' + fd.get('name'),
            _template: 'table', _captcha: 'false', language: L.lang,
          });
          say(L.ok, 'ok');
        } else if (form.dataset.brevo) {
          const body = new FormData(form);
          try {
            const r = await fetch(form.action + (form.action.includes('?') ? '&' : '?') + 'isAjax=1', { method: 'POST', body });
            const j = await r.json().catch(() => ({ success: r.ok }));
            if (!j.success) throw new Error('brevo');
          } catch (err) {
            if (err.message === 'brevo') throw err;
            await fetch(form.action, { method: 'POST', body: new FormData(form), mode: 'no-cors' });   // CORS kapalıysa yine de ilet
          }
          say(L.nlConfirm, 'ok');
        } else {
          await post(L.contact, {
            email: fd.get('EMAIL'), name: fd.get('FIRSTNAME') || '-', language: L.lang,
            _subject: 'Bülten aboneliği (' + L.lang.toUpperCase() + ') · ' + fd.get('EMAIL'),
            _template: 'table', _captcha: 'false',
          });
          say(L.nlOk, 'ok');
        }
        form.reset(); form.classList.remove('was-checked');
      } catch {
        say(L.err, 'err', true);
      } finally {
        btn.disabled = false; btn.textContent = label;
      }
    });
  });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
</Base>
