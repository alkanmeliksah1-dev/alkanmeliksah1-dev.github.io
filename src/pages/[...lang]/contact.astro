---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import { nav, photos, site, ui, type Lang } from '../../data';
import { langPaths } from '../../lib';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const title = nav.find((n) => n.slug === 'contact')!.label[lang];
const socials = Object.entries(site.social).filter(([, url]) => url);
---
<Base lang={lang} slug="contact" title={title} bg={photos.contact}>
  <Sheet title={title}>
    <p class="lead">{ui.contactLead[lang]}</p>
    <h2>{ui.email[lang]}</h2>
    <a class="contact-line" href={`mailto:${site.email}`}>{site.email}</a>
    <h2>{ui.basedIn[lang]}</h2>
    <p class="contact-line" style="border:0">{ui.city[lang]}</p>
    {socials.length > 0 && (<><h2>{ui.follow[lang]}</h2><ul class="rows">{socials.map(([k, u]) => <li><span class="k">{k}</span><a href={u}>{u}</a></li>)}</ul></>)}
  </Sheet>
</Base>
