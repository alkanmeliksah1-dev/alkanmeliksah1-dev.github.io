---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import { photos, site, ui, type Lang } from '../../data';
import { langPaths } from '../../lib';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const names: Record<string, string> = { soundcloud: 'SoundCloud', youtube: 'YouTube', instagram: 'Instagram' };
const socials = Object.entries(site.social).filter(([, url]) => url);
---
<Base lang={lang} slug="contact" bg={photos.contact}>
  <Sheet lang={lang} slug="contact">
    <p class="lead">{ui.contactLead[lang]}</p>
    <h2>{ui.email[lang]}</h2>
    <a class="contact-line" href={`mailto:${site.email}`}>{site.email}</a>
    <h2>{ui.basedIn[lang]}</h2>
    <p class="contact-line">{ui.city[lang]}</p>
    {socials.length > 0 && (<><h2>{ui.elsewhere[lang]}</h2><ul class="rows">{socials.map(([k, u]) => <li><span class="k">{names[k]}</span><a class="text-link" href={u} target="_blank" rel="noopener">{u.replace('https://', '')} ↗</a><span></span></li>)}</ul></>)}
  </Sheet>
</Base>
