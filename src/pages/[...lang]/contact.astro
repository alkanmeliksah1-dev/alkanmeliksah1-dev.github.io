---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import { photos, site, type Lang } from '../../data';
import { langPaths } from '../../lib';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const names: Record<string, string> = { youtube: 'YouTube', soundcloud: 'SoundCloud', instagram: 'Instagram', facebook: 'Facebook' };
const socials = Object.entries(site.social).filter(([, url]) => url);
---
<Base lang={lang} slug="contact" bg={photos.contact}>
  <Sheet lang={lang} slug="contact">
    <a class="contact-line" href={`mailto:${site.email}`}>{site.email}</a>
    {socials.length > 0 && (
      <ul class="socials">
        {socials.map(([k, u]) => <li><a href={u} target="_blank" rel="noopener">{names[k]} <span aria-hidden="true">↗</span></a></li>)}
      </ul>
    )}
  </Sheet>
</Base>
