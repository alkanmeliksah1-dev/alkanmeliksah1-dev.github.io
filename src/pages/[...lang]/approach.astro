---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import { photos, statement, type Lang } from '../../data';
import { langPaths } from '../../lib';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang} slug="approach" bg={photos.approach}>
  <Sheet lang={lang} slug="approach">
    <div class="statement">{statement[lang].map((p) => <p>{p}</p>)}</div>
  </Sheet>
</Base>
